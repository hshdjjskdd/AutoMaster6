# Токен бота, полученный у @BotFather (формат: 123456789:AAH...)
BOT_TOKEN=

# --- Необязательные параметры ---
# Строка подключения к БД. По умолчанию используется файл data/auto_master.db в папке проекта.
# DATABASE_URL=sqlite+aiosqlite:///./data/auto_master.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Выводить SQL-запросы в лог (true/false)
# SQL_ECHO=false
